generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String           @id @default(uuid())
  name                 String
  email                String           @unique
  password             String
  role                 Role             @default(CLIENT)
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  phone                String?
  location             String?
  resetPasswordExpires DateTime?
  resetPasswordToken   String?          @unique
  emailOtp             String?
  isEmailVerified      Boolean          @default(false)
  isPhoneVerified      Boolean          @default(false)
  otpExpires           DateTime?
  phoneOtp             String?
  city                 String?
  state                String?
  streetAddress        String?
  zipCode              String?
  country              String?
  latitude             Float?
  longitude            Float?
  confirmationsEnabled Boolean          @default(true)
  marketingEnabled     Boolean          @default(false)
  remindersEnabled     Boolean          @default(true)
  lastSeen             DateTime?
  clientAppointments   Appointment[]    @relation("ClientAppointments")
  favorites            Favorite[]       @relation("ClientFavorites")
  receivedMessages     Message[]        @relation("ReceivedMessages")
  sentMessages         Message[]        @relation("SentMessages")
  notifications        Notification[]
  providerProfile      ProviderProfile?
  siteReviews          SiteReview[]
  addresses            Address[]
}

model Address {
  id            String        @id @default(uuid())
  userId        String
  label         String        @default("Home") // "Home", "Work", "Other", or custom
  streetAddress String
  city          String
  state         String?
  zipCode       String?
  country       String?       @default("India")
  latitude      Float?
  longitude     Float?
  isDefault     Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointments  Appointment[]
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  message   String
  isRead    Boolean  @default(false)
  link      String?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}

model ProviderProfile {
  id                   String        @id @default(uuid())
  userId               String        @unique
  specialty            String
  about                String?
  rating               Float         @default(0.0)
  phone                String?
  location             String?
  workingDays          String[]      @default(["MON", "TUE", "WED", "THU", "FRI"])
  availableSlots       String[]      @default(["09:00", "10:00", "11:00", "14:00", "15:00", "16:00"])
  blockedDates         String[]      @default([])
  workSchedule         Json?         @default("{}")
  isVerified           Boolean       @default(false)
  verificationDocument String?
  appointments         Appointment[] @relation("ProviderAppointments")
  favoritedBy          Favorite[]    @relation("ProviderFavorites")
  user                 User          @relation(fields: [userId], references: [id])
  services             Service[]
}

model Service {
  id                String          @id @default(uuid())
  providerProfileId String
  name              String
  duration          Int
  price             Float
  category          String          @default("General")
  appointments      Appointment[]
  provider          ProviderProfile @relation(fields: [providerProfileId], references: [id])
}

model Appointment {
  id             String          @id @default(uuid())
  clientId       String
  providerId     String
  serviceId      String
  addressId      String?
  address        Address?        @relation(fields: [addressId], references: [id])
  serviceAddress String?
  latitude       Float?
  longitude      Float?
  date           DateTime
  status         Status          @default(PENDING)
  note           String?
  client         User            @relation("ClientAppointments", fields: [clientId], references: [id])
  provider       ProviderProfile @relation("ProviderAppointments", fields: [providerId], references: [id])
  service        Service         @relation(fields: [serviceId], references: [id])
  review         Review?
}

model Review {
  id            String      @id @default(uuid())
  appointmentId String      @unique
  rating        Int
  comment       String?
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
}

model Favorite {
  id                String          @id @default(uuid())
  clientId          String
  providerProfileId String
  createdAt         DateTime        @default(now())
  client            User            @relation("ClientFavorites", fields: [clientId], references: [id])
  providerProfile   ProviderProfile @relation("ProviderFavorites", fields: [providerProfileId], references: [id])

  @@unique([clientId, providerProfileId])
}

model SiteReview {
  id        String   @id @default(uuid())
  userId    String?
  name      String
  rating    Int
  comment   String
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}

model Message {
  id          String    @id @default(uuid())
  senderId    String
  receiverId  String
  content     String
  status      String    @default("SENT") // "SENT" | "DELIVERED" | "READ"
  isRead      Boolean   @default(false)
  deliveredAt DateTime?
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  receiver    User      @relation("ReceivedMessages", fields: [receiverId], references: [id])
  sender      User      @relation("SentMessages", fields: [senderId], references: [id])
}

model SignupOtp {
  id         String   @id @default(uuid())
  identifier String
  otp        String
  type       String
  expiresAt  DateTime
  verified   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([identifier, type])
}

enum Role {
  CLIENT
  PROVIDER
  ADMIN
}

enum Status {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}
