generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENT
  PROVIDER
}

enum Status {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
}

model User {
  id                   String    @id @default(uuid())
  name                 String
  email                String    @unique
  password             String
  role                 Role      @default(CLIENT)
  phone                String?
  location             String?
  resetPasswordToken   String?   @unique
  resetPasswordExpires DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  clientAppointments Appointment[]  @relation("ClientAppointments")
  favorites          Favorite[]     @relation("ClientFavorites")
  providerProfile    ProviderProfile?
  notifications      Notification[]
  siteReviews        SiteReview[]
  sentMessages       Message[] @relation("SentMessages")
  receivedMessages   Message[] @relation("ReceivedMessages")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String   // BOOKING_REQUESTED, BOOKING_CONFIRMED, BOOKING_CANCELLED, etc.
  title     String
  message   String
  isRead    Boolean  @default(false)
  link      String?  // URL to navigate to when clicked
  createdAt DateTime @default(now())
}

model ProviderProfile {
  id        String   @id @default(uuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  specialty String
  about     String?
  rating    Float    @default(0.0)
  phone     String?
  location  String?
  workingDays    String[] @default(["MON", "TUE", "WED", "THU", "FRI"])
  availableSlots String[] @default(["09:00", "10:00", "11:00", "14:00", "15:00", "16:00"])
  workSchedule   Json?    @default("{}")
  blockedDates   String[] @default([])

  services      Service[]
  appointments  Appointment[] @relation("ProviderAppointments")
  favoritedBy   Favorite[]    @relation("ProviderFavorites")
}

model Service {
  id                String          @id @default(uuid())
  providerProfileId String
  provider          ProviderProfile @relation(fields: [providerProfileId], references: [id])
  name              String
  category          String          @default("General")
  duration          Int             // minutes
  price             Float
  appointments      Appointment[]
}

model Appointment {
  id         String   @id @default(uuid())
  clientId   String
  client     User     @relation("ClientAppointments", fields: [clientId], references: [id])
  providerId String
  provider   ProviderProfile @relation("ProviderAppointments", fields: [providerId], references: [id])
  serviceId  String
  service    Service  @relation(fields: [serviceId], references: [id])
  date       DateTime
  status     Status   @default(PENDING)
  note       String?

  review     Review?
}

model Review {
  id            String      @id @default(uuid())
  appointmentId String      @unique
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  rating        Int
  comment       String?
}

model Favorite {
  id                String          @id @default(uuid())
  clientId          String
  client            User            @relation("ClientFavorites", fields: [clientId], references: [id])
  providerProfileId String
  providerProfile   ProviderProfile @relation("ProviderFavorites", fields: [providerProfileId], references: [id])
  createdAt         DateTime        @default(now())

  @@unique([clientId, providerProfileId])
}

model SiteReview {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  name      String   // Display name
  rating    Int
  comment   String
  createdAt DateTime @default(now())
}

model Message {
  id         String   @id @default(uuid())
  senderId   String
  sender     User     @relation("SentMessages", fields: [senderId], references: [id])
  receiverId String
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  content    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
}
