# Server Port
PORT=5000

# PostgreSQL Database URL (e.g. Supabase / Neon / Render Postgres)
DATABASE_URL="postgresql://user:password@host:5432/appointly?sslmode=require"

# JWT Authentication Secrets (Generate secure random strings in production)
JWT_SECRET="your_jwt_secret_key_here"
JWT_EXPIRES_IN=30d
ACCESS_TOKEN_EXPIRES_IN=30d
REFRESH_TOKEN_EXPIRES_IN=30d

# Frontend URL (For CORS & email action links. Can be comma-separated if multiple domains)
FRONTEND_URL=https://your-frontend-domain.vercel.app

# EmailJS Service Configuration (For transactional emails)
EMAILJS_SERVICE_ID=your_emailjs_service_id
EMAILJS_TEMPLATE_ID=your_emailjs_template_id
EMAILJS_GENERIC_TEMPLATE_ID=your_emailjs_generic_template_id
EMAILJS_PUBLIC_KEY=your_emailjs_public_key
EMAILJS_PRIVATE_KEY=your_emailjs_private_key

# Google OAuth Client ID (matching frontend)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# SMS Gateway (Fast2SMS for phone OTPs, optional)
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Redis In-Memory Cache & Rate Limiting (Optional in dev, recommended in prod)
# Local: redis://127.0.0.1:6379 | AWS ElastiCache: redis://your-redis-cluster-endpoint:6379
REDIS_URL="redis://127.0.0.1:6379"
